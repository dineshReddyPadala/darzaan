# Copy to .env.staging (gitignored). Used by compose:staging and staged host process runs.
DARZAAN_ENV=staging
NODE_ENV=production
JWT_SECRET=replace-with-staging-jwt-secret
CORS_ORIGINS=https://staff-staging.example
SEED_PASSWORD=

AUTH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/darzaan_auth
CORE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/darzaan_core
NOTIFICATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/darzaan_notification

REDIS_URL=redis://HOST:6379
RATE_LIMIT_PER_MINUTE=120

KAFKA_BROKERS=HOST:9092
KAFKA_CLIENT_ID=darzaan-staging

WEB_URL=https://staff-staging.example

FROM_MAIL=orugalluraju@gmail.com
FROM_MAIL_PASSWORD=lqhm liud uypk wbua

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-staging.example/v1/traces
LOG_LEVEL=info

# Staff web image build (docker compose build args on host)
VITE_API_URL=https://api-staging.example
VITE_API_MODE=http