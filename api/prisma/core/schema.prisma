generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/core"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_DATABASE_URL")
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  mobile    String    @default("")
  email     String    @default("")
  city      String    @default("")
  tier      String    @default("New")
  designer  String    @default("")
  store     String    @default("Khan Market")
  storeId   Int?      @map("store_id")
  document  Json
  deletedAt DateTime? @map("deleted_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  orders    Order[]

  @@index([mobile])
  @@index([name])
  @@index([storeId])
  @@map("customers")
}

model Order {
  id           Int              @id @default(autoincrement())
  customerId   Int              @map("customer_id")
  status       String
  store        String
  storeId      Int?             @map("store_id")
  deliveryDate String           @map("delivery_date")
  priority     String
  version      Int              @default(1)
  document     Json
  deletedAt    DateTime?        @map("deleted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  customer     Customer         @relation(fields: [customerId], references: [id])
  garments     Garment[]
  payments     Payment[]
  tasks        ProductionTask[]
  alterations  Alteration[]
  trials       Trial[]
  activities   ActivityEvent[]

  @@index([store, status, deliveryDate])
  @@index([customerId])
  @@index([storeId])
  @@map("orders")
}

model Garment {
  id          Int                  @id @default(autoincrement())
  orderId     Int                  @map("order_id")
  category    String
  subCategory String               @map("sub_category")
  stage       String
  assignee    String?
  document    Json
  version     Int                  @default(1)
  deletedAt   DateTime?            @map("deleted_at")
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pieces      GarmentFabricPiece[]
  sketches    EmbroideryVersion[]

  @@index([stage, assignee])
  @@index([orderId])
  @@index([deletedAt])
  @@map("garments")
}

model GarmentFabricPiece {
  id        Int     @id @default(autoincrement())
  garmentId Int     @map("garment_id")
  material  String
  length    Float
  unit      String
  notes     String    @default("")
  deletedAt DateTime? @map("deleted_at")
  garment   Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([garmentId])
  @@index([deletedAt])
  @@map("garment_fabric_pieces")
}

model EmbroideryVersion {
  id        Int     @id @default(autoincrement())
  garmentId Int     @map("garment_id")
  label     String
  note      String  @default("")
  status    String
  at        String
  deletedAt DateTime? @map("deleted_at")
  garment   Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([garmentId])
  @@index([deletedAt])
  @@map("embroidery_versions")
}

model Payment {
  id        Int    @id @default(autoincrement())
  orderId   Int    @map("order_id")
  amount    Int
  method    String
  reference String @default("")
  at        String
  by        String @default("")
  kind      String
  deletedAt DateTime? @map("deleted_at")
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
  @@index([deletedAt])
  @@map("payments")
}

model ProductionTask {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  garmentId Int?    @map("garment_id")
  name      String
  stage     String
  assignee  String?
  status    String
  document  Json
  deletedAt DateTime? @map("deleted_at")
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([stage, assignee])
  @@index([deletedAt])
  @@map("production_tasks")
}

model PriceRequest {
  id        Int      @id @default(autoincrement())
  status    String
  orderId   Int?     @map("order_id")
  garmentId Int?     @map("garment_id")
  document  Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("price_requests")
}

model QcInspection {
  id        Int     @id @default(autoincrement())
  orderId   Int?    @map("order_id")
  garmentId Int?    @map("garment_id")
  outcome   String
  document  Json
  at        String

  @@index([orderId, garmentId])
  @@map("qc_inspections")
}

model QcRework {
  id        Int     @id @default(autoincrement())
  orderId   Int?    @map("order_id")
  garmentId Int?    @map("garment_id")
  status    String
  document  Json

  @@index([status])
  @@map("qc_reworks")
}

model Trial {
  id       Int    @id @default(autoincrement())
  orderId  Int    @map("order_id")
  date     String
  time     String
  status   String
  document  Json
  deletedAt DateTime? @map("deleted_at")
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([deletedAt])
  @@map("trials")
}

model Alteration {
  id       Int    @id @default(autoincrement())
  orderId  Int    @map("order_id")
  status   String
  charge   Int    @default(0)
  document  Json
  deletedAt DateTime? @map("deleted_at")
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([deletedAt])
  @@map("alterations")
}

model ActivityEvent {
  id      Int    @id @default(autoincrement())
  orderId Int    @map("order_id")
  at      String
  who     String
  what    String
  kind      String
  deletedAt DateTime? @map("deleted_at")
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
  @@index([deletedAt])
  @@map("activity_events")
}

model Store {
  id        Int      @id @default(autoincrement())
  name      String
  kind      String   @default("store")
  address   String   @default("")
  phone     String   @default("")
  code      String?
  active    Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt])
  @@map("stores")
}

model Snapshot {
  key       String   @id
  body      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("snapshots")
}

model IdempotencyKey {
  id           String    @id @default(cuid())
  scope        String
  key          String
  requestHash  String    @map("request_hash")
  status       String
  responseCode Int?      @map("response_code")
  responseBody Json?     @map("response_body")
  lockedUntil  DateTime? @map("locked_until")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String    @id
  type          String
  version       Int
  aggregateId   String    @map("aggregate_id")
  payload       Json
  correlationId String    @map("correlation_id")
  causationId   String?   @map("causation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  lockedAt      DateTime? @map("locked_at")
  attempts      Int       @default(0)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([consumer, eventId])
  @@map("processed_events")
}

model RetryJob {
  id            String   @id
  topic         String
  payload       Json
  attempt       Int
  nextAttemptAt DateTime @map("next_attempt_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([nextAttemptAt])
  @@map("retry_jobs")
}

model Appointment {
  id              Int      @id @default(autoincrement())
  reference       String   @unique
  name            String
  phone           String
  email           String   @default("")
  service         String
  mode            String
  appointmentDate String   @map("appointment_date")
  appointmentTime String   @map("appointment_time")
  notes           String   @default("")
  status          String   @default("requested")
  consent         Boolean
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([appointmentDate, mode, status])
  @@map("appointments")
}

model FranchiseLead {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  profile   String
  area      String
  consent   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@map("franchise_leads")
}
