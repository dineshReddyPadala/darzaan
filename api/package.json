{
  "name": "darzaan-api",
  "version": "1.0.0",
  "private": true,
  "description": "Darzaan NestJS services: gateway, auth, core, notifications, worker.",
  "scripts": {
    "build": "nest build api-gateway && nest build auth-service && nest build core-service && nest build notification-service && nest build worker",
    "start:gateway": "node scripts/start.mjs api-gateway",
    "start:auth": "node scripts/start.mjs auth-service",
    "start:core": "node scripts/start.mjs core-service",
    "start:notification": "node scripts/start.mjs notification-service",
    "start:worker": "node scripts/start.mjs worker",
    "start:dev": "node scripts/dev.mjs",
    "prisma:generate": "prisma generate --schema prisma/auth/schema.prisma && prisma generate --schema prisma/core/schema.prisma && prisma generate --schema prisma/notification/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/auth/schema.prisma && prisma migrate deploy --schema prisma/core/schema.prisma && prisma migrate deploy --schema prisma/notification/schema.prisma",
    "seed:export": "node scripts/export-seed.mjs",
    "seed": "tsx prisma/seed.ts",
    "test": "jest --runInBand",
    "lint": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\" --max-warnings 0"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.8",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.62.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.7.0",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^10.4.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.36.0",
    "jest": "^29.7.0",
    "prisma": "^6.16.2",
    "ts-jest": "^29.4.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
