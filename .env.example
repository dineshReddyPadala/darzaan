# Set strong credentials before exposing an admin endpoint
ADMIN_USERNAME=darzaan-admin
ADMIN_PASSWORD=REPLACE_WITH_32_CHAR_RANDOM_SECRET
DARZAAN_DB_PATH=/var/lib/darzaan/darzaan.sqlite3
FORCE_HTTPS=1
# Optional: approved Meta WhatsApp Business template, 4 body parameters:
# {{1}} customer_name, {{2}} date, {{3}} time, {{4}} reference
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
